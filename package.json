{
  "name": "rhino-web-viewer",
  "version": "1.0.0-preview",
  "private": true,
  "description": "Export Rhino models as self-contained interactive HTML pages.",
  "type": "module",
  "scripts": {
    "setup": "node bootstrap.mjs",
    "build": "node build.mjs && node create-demo.mjs",
    "build:fixtures": "node qa/create-fixture.mjs",
    "build:plugin": "powershell -NoProfile -File plugin/Build.ps1 -ViewerTemplate dist/ViewerTemplate.html -OutputDirectory dist/plugin",
    "preview": "node preview-server.mjs",
    "test:glb": "powershell -NoProfile -File qa/Test-GlbValidation.ps1",
    "package": "powershell -NoProfile -File package-release.ps1"
  },
  "dependencies": { "three": "0.180.0" },
  "devDependencies": { "esbuild": "0.25.10" },
  "engines": { "node": ">=20" }
}
